NEXT_PUBLIC_API_URL=http://localhost:5001/api

# Public site URL — used for sitemap, robots.txt, and Open Graph (no trailing slash)
PORT=3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Google Maps API key (optional — only used for external "Get directions" / pin links on google.com)
# In-app maps use free MapLibre tiles and do not require this key.
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# Google reCAPTCHA v2 site key (optional in dev)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
